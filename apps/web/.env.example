# Copy to .env.local for local development.
# Public API base URL (do not include a trailing slash).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Clerk frontend keys are required when authentication UI integration is enabled.
# Never commit real keys or secrets to GitHub.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Configure these routes when Clerk middleware/provider is enabled.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/my-listings
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/my-listings
