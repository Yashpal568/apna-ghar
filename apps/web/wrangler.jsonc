{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "apna-ghar-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "INTERNAL_API_URL": "https://apna-ghar-api-w0dk.onrender.com/api/v1",
    "API_UPSTREAM_URL": "https://apna-ghar-api-w0dk.onrender.com/api/v1",
    "NEXT_PUBLIC_API_BASE_URL": "https://apna-ghar-api-w0dk.onrender.com/api/v1"
  }
}
